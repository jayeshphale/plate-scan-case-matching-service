# ==============================================================================
# Plate Scan & Case Matching Service - Environment Configuration
# ==============================================================================

# Database Connection
# PostgreSQL (Docker / Production / Local Postgres):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/platescan
# SQLite Fallback (Local zero-dependency testing):
# DATABASE_URL=sqlite:///./platescan.db

# JWT & Security
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External Partner Eligibility Service
ELIGIBILITY_SERVICE_URL=http://localhost:8000/mock/partner-network/eligibility

# Environment & CORS
ENVIRONMENT=development

# Frontend Vite API Base URL
VITE_API_BASE_URL=/api/v1
